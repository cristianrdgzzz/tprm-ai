# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (shared by the project tables and n8n) ---
POSTGRES_USER=tprm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tprm_ai

# --- n8n ---
TZ=Europe/Madrid
# Generate with: openssl rand -hex 32
# If you reuse an existing n8n data folder, use the key stored in n8n-data/config
N8N_ENCRYPTION_KEY=change-me

# --- LLM (only ever receives anonymized text) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- RAG layer (optional profile "rag") ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
